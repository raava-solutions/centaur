# Tailscale OAuth client credentials.
# NOTE: these are used in the OAuth client-credentials request BODY (not an
# HTTP header), so they must be present as real environment variables — they
# are intentionally NOT declared as http-type secrets in pyproject.toml.
# Read-scope pair (devices, ACL policy, DNS):
CENTAUR_TAILSCALE_CLIENT_ID=
CENTAUR_TAILSCALE_CLIENT_SECRET=
# Audit-log-scope pair (separate OAuth client with auditLogs scope):
CENTAUR_TAILSCALE_AUDIT_CLIENT_ID=
CENTAUR_TAILSCALE_AUDIT_CLIENT_SECRET=
