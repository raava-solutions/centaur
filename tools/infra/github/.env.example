# GitHub App (centaur-ops) credentials.
# NOTE: these are used to mint JWTs and installation access tokens locally
# (not sent as static HTTP headers), so they must be present as real
# environment variables — intentionally NOT declared as http-type secrets in
# pyproject.toml.
# GitHub App ID
CENTAUR_GITHUB_APP_ID=
# GitHub App private key, PEM format (literal "\n" sequences are normalized)
CENTAUR_GITHUB_APP_PEM=
# API base URL override (e.g. GitHub Enterprise Server)
CENTAUR_GITHUB_API_URL=https://api.github.com
